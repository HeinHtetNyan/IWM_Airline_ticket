# App Configuration
APP_NAME=Air Ticket Booking API
APP_DESCRIPTION=Backend API for flight search and booking system
APP_VERSION=1.0.0
APP_ROOT_MESSAGE=FastAPI running in Docker
ENVIRONMENT=development
# Change BASE_URL per environment so generated secure file URLs point to the
# real backend domain in staging/production instead of localhost.
BASE_URL=http://localhost:8000
BACKEND_PORT=8000
NGINX_PORT=8080

# PostgreSQL
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# Redis
REDIS_PASSWORD=your_redis_password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
FLIGHT_CACHE_TTL=900
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12
BOOKING_AUTO_CANCEL_EXPIRE_MINUTES=30
LIFECYCLE_JOB_INTERVAL_MINUTES=5
STARTUP_DB_MAX_RETRIES=10
STARTUP_DB_RETRY_DELAY_SECONDS=2

# File Storage
STORAGE_TYPE=local
# Used only for local storage. Keep this as a writable container path.
UPLOAD_DIR=/app/uploads
# Switch STORAGE_TYPE to s3 in production and replace these placeholders with
# your real bucket, region, credentials, and CDN/base URL.
S3_BUCKET=your_s3_bucket_name
S3_REGION=your_region
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BASE_URL=https://your-cdn-url.com

# JWT / Authentication
JWT_SECRET=your_super_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TOKEN_EXPIRE_MINUTES_RESET=15
TOKEN_EXPIRE_MINUTES_VERIFY=15

# Email Configuration
EMAIL_ENABLED=true
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_REQUIRE_AUTH=true
EMAIL_TIMEOUT_SECONDS=10

# ACTIVE (Mailtrap)
EMAIL_HOST=send.api.mailtrap.io
EMAIL_PORT=587
EMAIL_USERNAME=api
EMAIL_PASSWORD=your_mailtrap_password
MAILTRAP_API_TOKEN=your_mailtrap_api_token
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Your App Name

# FALLBACK (SMTP2GO)
# EMAIL_HOST=mail.smtp2go.com
# EMAIL_PORT=587
# EMAIL_USERNAME=your_smtp2go_username
# EMAIL_PASSWORD=your_smtp2go_password
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_FROM_NAME=Your App Name
FRONTEND_BASE_URL=http://localhost:3000

# Auth Rate Limiting
RATE_LIMIT_FORGOT_PASSWORD=5
RATE_LIMIT_RESEND_EMAIL=5
RATE_LIMIT_WINDOW_SECONDS=3600

# API Behavior
CANCELLED_BOOKING_DELETE_DAYS=7
CORS_ALLOW_ORIGINS=[http://localhost:3000,http://localhost:5173](http://localhost:3000,http://localhost:5173)

# External APIs
TICKET_API_KEY=your_ticket_api_key
CURRENCY_API_KEY=your_currency_api_key
