### Example environment variables for IWM Airline Ticket

# Postgres connection used by backend (change host/port when running locally)
DATABASE_URL=postgresql://airuser:airpassword@localhost:5433/airdb

# Application settings
SECRET_KEY=replace-with-a-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_NAME=IWM Airline Ticket API

# External services
TICKET_API_KEY=replace-with-ticket-api-key
# Database
SECRET_KEY= #change-me-to-a-long-random-string
ALGORITHM= #HS256
ACCESS_TOKEN_EXPIRE_MINUTES= #60
DATABASE_URL=

# External APIs
TICKET_API_KEY= #(ENTER YOUR API KEY)
CURRENCY_API_KEY=
