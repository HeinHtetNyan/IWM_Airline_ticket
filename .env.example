# ────────────────────────────────────────────────────────────────
# PostgreSQL (used by backend & compose db service)
# ────────────────────────────────────────────────────────────────
POSTGRES_USER=airticket
POSTGRES_PASSWORD=ChangeThisStrongPass789!
POSTGRES_DB=airticket_db

# Full connection string (backend )
DATABASE_URL=postgresql://airticket:ChangeThisStrongPass789!@db:5432/airticket_db

# ────────────────────────────────────────────────────────────────
# Application / JWT settings
# ────────────────────────────────────────────────────────────────
JWT_SECRET=super-long-random-secret-key-for-jwt-20260222-abcdefghijklmnopqrstuvwxyz1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CANCELLED_BOOKING_DELETE_DAYS=7
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ────────────────────────────────────────────────────────────────
# Redis (caching, sessions, etc.)
# ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=default-strong-pass-1234567890
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
FLIGHT_CACHE_TTL=900
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12

# ────────────────────────────────────────────────────────────────
# External API keys (leave empty or dummy until real integration)
# ────────────────────────────────────────────────────────────────
TICKET_API_KEY=dummy-currency-key-for-testing-only
CURRENCY_API_KEY=dummy-currency-key-for-testing-only

# ────────────────────────────────────────────────────────────────
# App metadata (optional)
# ────────────────────────────────────────────────────────────────
APP_NAME=IWM Airline Ticket API
